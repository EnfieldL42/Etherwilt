  requiredStageID: 0
  greetingDialogueString:
  - "So\u2026 you\u2019ve arrived."
  greetingDialogueAudio:
  - {fileID: 8300000, guid: 058554bb9a98f5f4a907d66a3884253a, type: 3}
  dialogueString:
  - Who am I? Some call me the alchemist, but worry not about trivial matters.
  - You took longer than expected. No matter, the cycle insists on repeating itself.
  - You've seen them, haven't you? Those corrupted beings.
  dialogueAudio:
  - {fileID: 8300000, guid: 058554bb9a98f5f4a907d66a3884253a, type: 3}
  - {fileID: 8300000, guid: 058554bb9a98f5f4a907d66a3884253a, type: 3}
  - {fileID: 8300000, guid: 058554bb9a98f5f4a907d66a3884253a, type: 3}
  dialogueIndex: 0
  farewellDialogueString:
  - They only breath because the ether refuses to let them die. Incomple vessels...
    if you will. Feeding off a broken world.
  farewellDialogueAudio:
  - {fileID: 8300000, guid: 058554bb9a98f5f4a907d66a3884253a, type: 3}
  setStageIndex: 1
  stageID: 1
